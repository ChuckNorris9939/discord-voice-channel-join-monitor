# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Testing Mode
APP_TESTING_MODE=false

# Logging Configuration
LOG_LEVEL=INFO
DISCORD_LOG_LEVEL=INFO

# Flask Server Configuration
PORT=8080

# Garmin Voice Recording Configuration
# Legacy Recording Settings
GARMIN_RECORD_SECONDS=600

# Audio Buffer Settings  
GARMIN_MAX_BUFFER_DURATION=600

# Speech-to-Text Processing
GARMIN_PROCESS_INTERVAL=3.0

# Speech-to-Text Configuration
STT_ENABLED=true
STT_ENGINE=google
VOSK_MODEL_PATH=data/assets/models

# Garmin Auto-Join Configuration
GARMIN_AUTO_JOIN_ENABLED=false
GARMIN_AUTO_JOIN_CHANNELS=1080202313211326584,571755941725208616,492036470681632778

# Garmin STT Output Configuration
GARMIN_STT_OUTPUT_ENABLED=true

# Copy this file to .env and update the values as needed
# Make sure to never commit your actual .env file to version control 