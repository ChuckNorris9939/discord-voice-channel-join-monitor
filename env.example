# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Testing Mode
APP_TESTING_MODE=false

# Logging Configuration
LOG_LEVEL=INFO

# Flask Server Configuration
PORT=8080

# Garmin Voice Recording Configuration
# Audio Settings
GARMIN_RECORD_SECONDS=600
GARMIN_SAMPLERATE=48000
GARMIN_CHANNELS=2
GARMIN_BYTES_PER_SAMPLE=2
GARMIN_FRAMES_PER_BUFFER=960

# Audio Processing Settings (for stuttering prevention)
GARMIN_PROCESS_INTERVAL=3.0
GARMIN_WINDOW_MIN=48000
GARMIN_WINDOW_MAX=240000
GARMIN_BUFFER_PREFILL=384000
GARMIN_BUFFER_OVERFLOW=0.6

# Audio Pipeline Health Monitoring
GARMIN_AUDIO_CALLBACK_TIMEOUT=5.0
GARMIN_MIN_AUDIO_CHUNK=960
GARMIN_MAX_AUDIO_CHUNK=19200
GARMIN_AUDIO_ERROR_THRESHOLD=10

# Recording Management
GARMIN_RECORDING_RESTART_DELAY=1.0
GARMIN_MAX_RECORDING_DURATION=3600
GARMIN_BUFFER_MONITOR_INTERVAL=30.0
GARMIN_MAX_RECORDING_ERRORS=5

# Speech-to-Text Configuration
STT_ENABLED=true
STT_ENGINE=google
VOSK_MODEL_PATH=assets/models

# Garmin Auto-Join Configuration
GARMIN_AUTO_JOIN_ENABLED=false
GARMIN_AUTO_JOIN_CHANNELS=1080202313211326584,571755941725208616,492036470681632778

# Copy this file to .env and update the values as needed
# Make sure to never commit your actual .env file to version control 