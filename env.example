# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Testing Mode
APP_TESTING_MODE=false

# Logging Configuration
LOG_LEVEL=INFO

# Flask Server Configuration
PORT=8080

# Garmin Voice Recording Configuration
# Audio Settings
GARMIN_RECORD_SECONDS=600
GARMIN_SAMPLERATE=48000
GARMIN_CHANNELS=2
GARMIN_BYTES_PER_SAMPLE=2
GARMIN_FRAMES_PER_BUFFER=960

# Recording Management
GARMIN_RECORDING_RESTART_DELAY=1.0
GARMIN_MAX_RECORDING_DURATION=3600
GARMIN_BUFFER_MONITOR_INTERVAL=30.0
GARMIN_MAX_RECORDING_ERRORS=5

# Speech-to-Text Configuration
STT_ENGINE=google
VOSK_MODEL_PATH=vosk-model-de

# Copy this file to .env and update the values as needed
# Make sure to never commit your actual .env file to version control 